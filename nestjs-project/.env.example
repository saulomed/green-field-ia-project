# Application
PORT=3000
NODE_ENV=development

# Database (use Docker Compose service name, never localhost)
DB_HOST=db
DB_PORT=5432
DB_USER=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# Mail (use Docker Compose service name, never localhost)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=StreamTube <noreply@streamtube.local>
APP_BASE_URL=http://localhost:3000

# Auth / JWT
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CONFIRM_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h

# Cookie flags
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
