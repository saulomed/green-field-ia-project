FROM node:25.6.0-slim

# Um único `RUN`: um `apt update` em camada própria vira índice velho assim que o
# mirror publica uma revisão, e o `apt install` de baixo passa a pedir `.deb` que
# já saíram do pool (404). Atualizar e instalar juntos mantém os dois em sincronia.
#
# Além do básico (`procps`, `curl`), aqui vão as bibliotecas de sistema do Chromium
# exigidas pelo Playwright. A imagem `slim` não as traz, e sem elas o binário baixado
# por `npx playwright install chromium` morre no launch com
# `libglib-2.0.so.0: cannot open shared object file`.
#
# A lista é a saída de `npx playwright install-deps --dry-run chromium` e vive aqui,
# no root do build, porque instalá-la depois exige `apt-get` como root dentro do
# container em execução — passo manual que se perde a cada recriação. Para atualizá-la,
# rode aquele comando na versão corrente do `@playwright/test` e substitua a lista;
# ela é estável entre versões menores.
RUN apt update && apt install -y --no-install-recommends \
      procps curl \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 \
      libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
      libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
      libxfixes3 libxkbcommon0 libxrandr2 xvfb fonts-noto-color-emoji \
      fonts-unifont libfontconfig1 libfreetype6 xfonts-scalable \
      fonts-liberation fonts-ipafont-gothic fonts-wqy-zenhei \
      fonts-tlwg-loma-otf fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/node/app

# O volume nomeado de `compose.yaml` que guarda os browsers do Playwright herda dono
# e permissões do diretório correspondente **na imagem**. Sem criá-lo aqui como `node`,
# o Docker o materializa vazio e pertencente a root, e `npx playwright install` falha
# com `EACCES: permission denied, mkdir '.../__dirlock'`.
RUN mkdir -p /home/node/.cache/ms-playwright && chown -R node:node /home/node/.cache

USER node

CMD [ "tail", "-f", "/dev/null" ]
