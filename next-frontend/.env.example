# Server-side only (Server Components, route handlers, server actions).
# Runs inside the container, so it resolves through the Docker Compose network.
API_BASE_URL=http://nestjs-api:3000

# E2E only (tests/, playwright.config.ts) — Mailpit's HTTP API, used to capture
# confirmation/reset e-mails during Playwright runs. Never used by app code.
MAILPIT_URL=http://mailpit:8025
