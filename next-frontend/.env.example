# Two base URLs on purpose: the same API is reached from two different networks.

# Server-side only (Server Components, route handlers, server actions).
# Runs inside the container, so it resolves through the Docker Compose network.
API_BASE_URL=http://nestjs-api:3000

# Browser-side. The browser runs on the host, which cannot resolve Compose
# service names — it must go through the published port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
